#!/usr/bin/env bash
# Wrapper around `git trim --squashed` that prints copy-paste worktree-removal
# commands for branches skipped because they're checked out in another worktree.

set -u

dry_run=0
for arg in "$@"; do
  [[ $arg == --dry-run ]] && dry_run=1
done

git trim --squashed "$@"
status=$?

worktrees=()
while IFS=$'\t' read -r kind _ path; do
  [[ $kind == skip-worktree ]] && worktrees+=("$path")
done < <(git trim --squashed "$@" --dry-run --porcelain 2>/dev/null || true)

[[ ${#worktrees[@]} -gt 0 ]] || exit "$status"

printf '\n'
if [[ $dry_run -eq 1 ]]; then
  msg=$(printf '[git trim] %d branch(es) would be blocked by worktrees. To unblock, you would need to run:' "${#worktrees[@]}")
else
  msg=$(printf '[git trim] %d branch(es) blocked by worktrees. To unblock, run:' "${#worktrees[@]}")
fi
if [[ -t 1 ]]; then
  printf '\033[33m%s\033[0m\n' "$msg"
else
  printf '%s\n' "$msg"
fi
for path in "${worktrees[@]}"; do
  printf '  git worktree remove %q\n' "$path"
done
printf '  git trim --squashed\n'
