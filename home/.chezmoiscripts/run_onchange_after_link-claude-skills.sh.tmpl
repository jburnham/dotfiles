#!/usr/bin/env bash
# Claude Code only discovers skills under ~/.claude/skills, so mirror
# ~/.agents/skills there as per-skill symlinks.
# Hashes the skill list from source state so a new skill links on the same apply.
# {{ range $k, $_ := include ".chezmoiexternals/skills.toml" | fromToml }} {{ $k }}{{ end }}
# {{ glob (joinPath .chezmoi.sourceDir "dot_agents/skills/*") | join " " }}
set -euo pipefail

src="$HOME/.agents/skills"
dst="$HOME/.claude/skills"

[[ -d $src ]] || exit 0
mkdir -p "$dst"

for skill in "$src"/*/; do
  skill=${skill%/}
  link="$dst/${skill##*/}"

  if [[ -L $link ]]; then
    target=$(readlink "$link")
    [[ $target == "$skill" ]] && continue
  fi
  if [[ -e $link || -L $link ]]; then
    echo "link-claude-skills: $link exists and is not a link to $skill, fix it by hand" >&2
    continue
  fi

  ln -s "$skill" "$link"
done
