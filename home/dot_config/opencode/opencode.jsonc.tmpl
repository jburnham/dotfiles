{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "/tmp/**": "allow",
      "~/go/**": "allow",
      "~/wk/src/**": "allow"
    }
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ]{{ if .work_computer }},
  "model": "amazon-bedrock/global.anthropic.claude-opus-5-5",
  "default_agent": "build-laconic",
  "agent": {
    "explore": {
      "model": "amazon-bedrock/global.anthropic.claude-sonnet-5-5"
    },
    "general": {
      "model": "amazon-bedrock/global.anthropic.claude-sonnet-5-5"
    }
  },
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "us-east-1",
        "profile": "bedrock-{{ .cred_tool }}"
      }
    }
  },
  "mcp": {
    "aws-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-proxy-for-aws@1.7.0",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--profile",{{ range splitList "," .aws_mcp_profiles }} {{ trim . | quote }},{{ end }}
        "--skip-auth", "--disable-telemetry", "--metadata",
        "INSTALL_SOURCE=aws-cli"
      ]
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "drop": {
      "type": "remote",
      "url": "https://{{ .drop_mcp_host }}/mcp",
      "enabled": false
    },
    "hub-tools": {
      "type": "remote",
      "url": "https://{{ .work_mcp_host }}/api/mcp/devtools",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": false
    },
    "grafana-tools": {
      "type": "local",
      "command": ["{{ .chezmoi.homeDir }}/.local/bin/grafana-mcp-wrapper"],
      "enabled": false
    },
    "infra-mcp": {
      "type": "remote",
      "url": "https://{{ .infra_mcp_host }}/mcp"
    }
  }{{ end }}
}
